# Copy to .env.local and fill in. Nothing here is required to run `npm run dev`:
# without keys the app uses scripted character replies and the browser's own speech engine.

# --- AI characters (paid) -------------------------------------------------
# Claude API key. When unset, characters reply with scripted demo lines.
ANTHROPIC_API_KEY=
# Model for character turns and summaries.
CLAUDE_MODEL=claude-opus-5-5

# --- Database --------------------------------------------------------------
# PostgreSQL connection string for `npm run db:migrate` and the seed. The app itself still runs on
# the in-memory store in this build; the Postgres-backed Store is the next step (see docs/ARCHITECTURE.md).
DATABASE_URL=

# --- Voice (paid, Phase 1 week 3+) -----------------------------------------
# Speech-to-text and text-to-speech providers: "browser" (default, dev only), "azure", "elevenlabs".
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
# Realtime transport (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Payments (merchant accounts needed) -----------------------------------
STRIPE_SECRET_KEY=
PAYMOB_API_KEY=

# --- Partner portal (dev stand-in until partner accounts ship) -------------
PARTNER_DEV_TOKEN=
PARTNER_DEV_VENUES=roastery
